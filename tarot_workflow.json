{
  "name": "Tarot Interpretation Webhook (compatible)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tarot",
        "responseMode": "lastNode",
        "responseData": "auto",
        "options": {}
      },
      "id": "Webhook_Trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "user",
            "content": "Ти досвідчений таролог.\nКористувач: {{$json[\"user\"]}}\nТип розкладу: {{$json[\"spread\"]}}\nКарти: {{$json[\"cards\"].join(\", \")}}\n\nОпиши значення карт у цьому розкладі українською мовою. Напиши з теплом і містикою, ніби це особисте тлумачення."
          }
        ]
      },
      "id": "OpenAI_Chat",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.openAi.chat",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "interpretation",
              "value": "={{$json[\"choices\"][0][\"message\"][\"content\"]}}"
            }
          ]
        },
        "options": {}
      },
      "id": "Set_Result",
      "name": "Set Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "Set Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "3"
}
